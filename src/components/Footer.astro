---

<footer style="border-top:1px solid var(--line);background:var(--page)">
  <div class="shell py-12 flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div>
      <p class="font-display text-lg m-0" style="color:var(--ink)">
        MR<span style="color:var(--accent)">.</span>
      </p>
      <p class="font-mono text-xs mt-2 m-0" style="color:var(--muted);letter-spacing:.04em">
        &copy; {year} Muhammad Rizky Sandyra · Built with Astro &amp; Tailwind
      </p>
    </div>

    <div class="flex items-center gap-1 -ml-2.5 md:ml-0">
      {socials.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          class="icon-btn"
          aria-label={`${s.label} (opens in a new tab)`}
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d={s.path} />
          </svg>
        </a>
      ))}
      <a
        href="mailto:muhammadrizkysandyra26@gmail.com"
        class="icon-btn"
        aria-label="Email Muhammad Rizky Sandyra"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5v9A1.5 1.5 0 004.5 18h15a1.5 1.5 0 001.5-1.5v-9m-18 0A1.5 1.5 0 014.5 6h15A1.5 1.5 0 0121 7.5m-18 0l8.24 5.07a1.5 1.5 0 001.52 0L21 7.5" />
        </svg>
      </a>
    </div>
  </div>
</footer>
