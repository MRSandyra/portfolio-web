---
export interface Props {
  title: string;
  description: string;
  tags: string[];
  github?: string;
  demo?: string;
  image?: string;
  featured?: boolean;
}

const { title, description, tags, github, demo, image, featured = false } = Astro.props;
---

<article class={`card group flex flex-col ${featured ? 'ring-2 ring-indigo-500/20' : ''}`}>
  <!-- Image placeholder -->
  <div class="relative h-48 bg-gradient-to-br from-slate-100 to-slate-200 dark:from-navy-800 dark:to-navy-700 overflow-hidden">
    {image ? (
      <img src={image} alt={title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
    ) : (
      <div class="absolute inset-0 flex items-center justify-center">
        <svg class="w-16 h-16 text-slate-300 dark:text-navy-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
      </div>
    )}
    {featured && (
      <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full text-xs font-mono font-medium bg-indigo-600 text-white">
        Featured
      </span>
    )}
  </div>

  <!-- Content -->
  <div class="p-6 flex flex-col flex-1">
    <h3 class="font-display text-xl text-navy-900 dark:text-white mb-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
      {title}
    </h3>
    <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed flex-1 mb-4">
      {description}
    </p>

    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5 mb-5">
      {tags.map(tag => (
        <span class="badge">{tag}</span>
      ))}
    </div>

    <!-- Links -->
    <div class="flex items-center gap-3 pt-4 border-t border-slate-100 dark:border-navy-700">
      {github && (
        <a href={github} target="_blank" rel="noopener" class="btn-outline text-xs py-2 px-4">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
          </svg>
          GitHub
        </a>
      )}
      {demo && (
        <a href={demo} target="_blank" rel="noopener" class="btn-primary text-xs py-2 px-4">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
          Live Demo
        </a>
      )}
    </div>
  </div>
</article>
