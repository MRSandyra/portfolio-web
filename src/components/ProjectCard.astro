---
import ProjectVisual from './charts/ProjectVisual.astro';

export interface Props {
  project: any;
  index?: number;
  variant?: 'grid' | 'feature';
}

const { project, index = 0, variant = 'grid' } = Astro.props;
const {
  slug, title, summary, kpis, stack, github, demo, demoNote, categories, featured, minor,
} = project;

const href = `/projects/${slug}`;
const isFeature = variant === 'feature';
/* A `minor` project carries no evidence visual, which is the whole point:
   it is the weakest item and should not sit level with the platforms. */
const showVisual = !minor;
const recordId = String(index + 1).padStart(2, '0');
---

<article
  class={`group flex flex-col overflow-hidden ${isFeature ? 'md:grid md:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]' : ''}`}
  style="background:var(--card);border:1px solid var(--line);border-radius:20px;
         transition:border-color var(--dur-ui) var(--ease),
                    box-shadow var(--dur-slow) var(--ease),
                    transform var(--dur-slow) var(--ease)"
  data-card
  data-categories={categories.join('|')}
>
  <!-- evidence -->
  {showVisual && (
    <div
      class="flex items-center justify-center p-4 sm:p-5 min-w-0"
      style="background:var(--sunk);border-bottom:1px solid var(--line)"
    >
      <div class="w-full">
        <ProjectVisual project={project} compact={!isFeature} showCaption={isFeature} />
      </div>
    </div>
  )}

  <!-- content -->
  <div class="p-6 sm:p-7 flex flex-col flex-1 min-w-0">
    <div class="flex items-center gap-2.5 flex-wrap mb-3.5">
      <span class="chip-accent">{categories[0]}</span>
      <span class="font-mono" style="font-size:10px;letter-spacing:.1em;color:var(--faint)">
        REC / {recordId}{featured ? ' · FEATURED' : ''}
      </span>
    </div>

    <h3 class={isFeature ? 'text-2xl sm:text-3xl' : 'text-2xl'}>
      <a
        href={href}
        class="no-underline"
        style="color:inherit;transition:color var(--dur-ui) var(--ease)"
        data-title-link
      >
        {title}
      </a>
    </h3>

    <p class="text-sm mt-2.5 mb-0" style="color:var(--muted);max-width:56ch">{summary}</p>

    <div class="kpis mt-5">
      {kpis.map((k: any) => (
        <div class="kpi">
          <b class="kpi-v">
            {k.value}{k.delta && <span class="kpi-d">{k.delta}</span>}
          </b>
          <span class="kpi-l">{k.label}</span>
        </div>
      ))}
    </div>

    <ul class="flex flex-wrap gap-1.5 mt-5 mb-0 p-0 list-none">
      {stack.slice(0, isFeature ? 6 : 4).map((t: string) => (
        <li class="chip">{t}</li>
      ))}
    </ul>

    <div
      class="flex flex-wrap items-center gap-3.5 mt-auto pt-5"
      style="border-top:1px solid var(--line);margin-top:1.375rem"
    >
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          Code
        </a>
      )}

      <a href={href} class="btn btn-link">
        Read the case study
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>

      {demo ? (
        <a href={demo} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
          Live demo
        </a>
      ) : (
        <span
          class="inline-flex items-center gap-2 font-mono text-xs"
          style="color:var(--faint);min-height:44px"
        >
          <span
            aria-hidden="true"
            style="width:6px;height:6px;border-radius:99px;background:var(--warn);flex:none"
          ></span>
          {demoNote}
        </span>
      )}
    </div>
  </div>
</article>

<style>
  article[data-card]:hover {
    border-color: var(--line-2) !important;
    box-shadow: 0 12px 34px -12px rgb(var(--shadow-col) / 0.22);
    transform: translateY(-3px);
  }
  article[data-card]:hover [data-title-link] {
    color: var(--accent);
  }
</style>
