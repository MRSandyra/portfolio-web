---
/**
 * Pipeline / architecture diagram.
 *
 * Vertical flow rather than a horizontal strip: the data-engineering projects
 * carry up to six stages plus a branch, and six boxes across a 360-unit viewBox
 * leaves ~46 units each, which is far too narrow to read. A vertical stack stays
 * legible at any stage count and at card width.
 *
 * It states structure only. Any number shown here is one the project records;
 * nothing is inferred. Status semantics live in src/data/projects.js.
 */
export interface Props {
  stages: { label: string; detail?: string }[];
  branch?: { label: string; fromIndex: number; stages: { label: string; detail?: string }[] };
  note?: string;
  status?: string;
  showCaption?: boolean;
}
const { stages, branch, note, status = 'structural', showCaption = true } = Astro.props;

const W = 360;
const PAD = 10;
const ROW_H = 38;
const GAP = 15;
const BOX_W = W - PAD * 2;

type Row = { kind: 'stage' | 'branch'; i: number; label: string; detail?: string; y: number };
const rows: Row[] = [];
let y = 4;

stages.forEach((s, i) => {
  rows.push({ kind: 'stage', i, label: s.label, detail: s.detail, y });
  y += ROW_H + GAP;
});

let branchHeaderY = 0;
if (branch) {
  branchHeaderY = y - GAP + 14;
  y = branchHeaderY + 20;
  branch.stages.forEach((s, i) => {
    rows.push({ kind: 'branch', i, label: s.label, detail: s.detail, y });
    y += ROW_H + GAP;
  });
}
const H = y - GAP + 6;

const forkAfter = branch ? stages[branch.fromIndex]?.label ?? '' : '';
const BRANCH_INSET = 18;

const captionByStatus: Record<string, string> = {
  measured: 'Structure of the running system. The figures shown are ones the project records.',
  structural: 'Pipeline structure. No performance figures are shown for this project because none were recorded — the stages above are what the code actually does.',
  method: 'Method structure only; it asserts no measured result.',
};
---

<figure class="m-0 w-full">
  <svg
    class="chart"
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label={`Pipeline: ${stages.map((s) => s.label).join(', then ')}.${
      branch ? ` Branch "${branch.label}" forks after ${forkAfter}: ${branch.stages.map((s) => s.label).join(', then ')}.` : ''
    }`}
  >
    <defs>
      <marker id="pl-arrow" viewBox="0 0 10 10" refX="8" refY="5"
              markerWidth="4" markerHeight="4" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="var(--line-2)" />
      </marker>
    </defs>

    {rows.map((r) => {
      const isBranch = r.kind === 'branch';
      const x = isBranch ? PAD + BRANCH_INSET : PAD;
      const w = isBranch ? BOX_W - BRANCH_INSET : BOX_W;
      const first = !isBranch && r.i === 0;
      return (
        <g>
          <rect
            x={x} y={r.y} width={w} height={ROW_H} rx="9"
            {/* The first stage is marked with an accent stroke, not an accent
                tint: on the dark tint the index and detail text only reached
                4.17:1. The surface stays var(--card) in every row. */}
            fill="var(--card)"
            stroke={first ? 'var(--accent-solid)' : 'var(--line-2)'}
            stroke-width={first ? '1.6' : '1'}
          />
          <text class="tick" x={x + 13} y={r.y + ROW_H / 2 + 3.5} style="fill:var(--faint)">
            {String(r.i + 1).padStart(2, '0')}
          </text>
          <text class="dlab" x={x + 36} y={r.y + ROW_H / 2 + 4} fill="var(--ink)">
            {r.label}
          </text>
          {r.detail && (
            <text class="tick" x={x + w - 13} y={r.y + ROW_H / 2 + 3.5}
                  text-anchor="end" style="fill:var(--muted)">
              {r.detail}
            </text>
          )}
        </g>
      );
    })}

    {/* connectors inside the main flow */}
    {stages.slice(0, -1).map((_, i) => (
      <line
        x1={PAD + 26} y1={4 + i * (ROW_H + GAP) + ROW_H + 2}
        x2={PAD + 26} y2={4 + (i + 1) * (ROW_H + GAP) - 2}
        stroke="var(--line-2)" stroke-width="1.5" marker-end="url(#pl-arrow)"
      />
    ))}

    {branch && (
      <g>
        <text class="tick" x={PAD + BRANCH_INSET} y={branchHeaderY + 4} style="fill:var(--accent)">
          ↳ {branch.label} — forks after {forkAfter}
        </text>
        {branch.stages.slice(0, -1).map((_, i) => (
          <line
            x1={PAD + BRANCH_INSET + 26} y1={branchHeaderY + 20 + i * (ROW_H + GAP) + ROW_H + 2}
            x2={PAD + BRANCH_INSET + 26} y2={branchHeaderY + 20 + (i + 1) * (ROW_H + GAP) - 2}
            stroke="var(--line-2)" stroke-width="1.5" marker-end="url(#pl-arrow)"
          />
        ))}
      </g>
    )}
  </svg>

  {showCaption && (
    <figcaption class="text-sm mt-3" style="color:var(--muted);max-width:62ch">
      <b style="color:var(--ink)">Pipeline structure.</b> {note ?? captionByStatus[status] ?? captionByStatus.structural}
    </figcaption>
  )}
</figure>
