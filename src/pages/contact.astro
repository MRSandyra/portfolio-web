---
import Layout from '../layouts/Layout.astro';

const contacts = [
  {
    label: 'Email',
    value: 'muhammadrizkysandyra26@gmail.com',
    href: 'mailto:muhammadrizkysandyra26@gmail.com',
    description: 'Best for project inquiries and job opportunities.',
    icon: `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
    </svg>`,
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/mrizkysandyra',
    href: 'https://linkedin.com/in/mrizkysandyra',
    description: 'Connect professionally and see my career journey.',
    icon: `<svg fill="currentColor" viewBox="0 0 24 24">
      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
    </svg>`,
  },
  {
    label: 'GitHub',
    value: 'github.com/MRSandyra',
    href: 'https://github.com/MRSandyra',
    description: 'Explore my open-source projects and code.',
    icon: `<svg fill="currentColor" viewBox="0 0 24 24">
      <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
    </svg>`,
  },
];
---

<Layout title="Contact" description="Get in touch with Muhammad Rizky Sandyra">
  <section class="pt-32 pb-20 px-6 max-w-5xl mx-auto">
    <div class="max-w-2xl mb-20">
      <p class="section-label">Get in Touch</p>
      <h1 class="font-display text-5xl md:text-6xl text-navy-900 dark:text-white mb-6">
        Let's <span class="italic text-indigo-600 dark:text-indigo-400">Connect</span>
      </h1>
      <p class="text-slate-500 dark:text-slate-400 text-lg leading-relaxed">
        I'm actively looking for full-time roles in data science, machine learning, and data analytics. Feel free to reach out — I'd love to discuss opportunities or collaborations.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-5 mb-16">
      {contacts.map((contact, i) => (
        <a
          href={contact.href}
          target={contact.href.startsWith('mailto') ? '_self' : '_blank'}
          rel="noopener"
          class={`group card p-6 flex gap-5 items-start no-underline observe-fade opacity-0-init animate-delay-${i * 100}`}
        >
          <div class="w-12 h-12 rounded-xl bg-indigo-100 dark:bg-indigo-900/40 text-indigo-600 dark:text-indigo-400 flex items-center justify-center flex-shrink-0 group-hover:bg-indigo-600 group-hover:text-white dark:group-hover:bg-indigo-600 transition-all duration-300">
            <div class="w-6 h-6" set:html={contact.icon}></div>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-mono font-medium text-indigo-500 dark:text-indigo-400 mb-1 uppercase tracking-wider">{contact.label}</p>
            <p class="font-medium text-navy-900 dark:text-white truncate mb-1 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
              {contact.value}
            </p>
            <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">{contact.description}</p>
          </div>
          <svg class="w-5 h-5 text-slate-300 dark:text-slate-600 group-hover:text-indigo-500 group-hover:translate-x-1 group-hover:-translate-y-1 transition-all duration-200 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      ))}
    </div>

    <div class="observe-fade opacity-0-init rounded-2xl border border-emerald-200 dark:border-emerald-900/50 bg-emerald-50 dark:bg-emerald-950/30 p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="flex items-start gap-4">
        <div class="w-3 h-3 rounded-full bg-emerald-500 mt-1.5 animate-pulse flex-shrink-0"></div>
        <div>
          <p class="font-medium text-emerald-800 dark:text-emerald-400 mb-1">Open to Work</p>
          <p class="text-sm text-emerald-700 dark:text-emerald-500 leading-relaxed">
            Available for full-time roles, freelance projects, and research collaborations. Remote or based in Indonesia.
          </p>
        </div>
      </div>
      <a href="mailto:muhammadrizkysandyra26@gmail.com" class="btn-primary bg-emerald-700 hover:bg-emerald-600 dark:bg-emerald-700 dark:hover:bg-emerald-600 flex-shrink-0">
        Send Email
      </a>
    </div>
  </section>
</Layout>