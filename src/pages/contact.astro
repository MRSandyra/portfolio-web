---
import Layout from '../layouts/Layout.astro';

const channels = [
  {
    label: 'Email',
    value: 'muhammadrizkysandyra26@gmail.com',
    href: 'mailto:muhammadrizkysandyra26@gmail.com',
    note: 'Best for roles and project enquiries.',
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/mrizkysandyra',
    href: 'https://linkedin.com/in/mrizkysandyra',
    note: 'Career history and professional context.',
  },
  {
    label: 'GitHub',
    value: 'github.com/MRSandyra',
    href: 'https://github.com/MRSandyra',
    note: 'Source for every project on this site.',
  },
];
---

<Layout
  title="Contact"
  description="Get in touch with Muhammad Rizky Sandyra — available for data science, machine learning and analytics roles, remote or based in Indonesia."
  ogImage="/og/contact.png"
>
  <section class="shell band-lg">
    <div class="max-w-prose">
      <p class="eyebrow m-0 rv rv-up">Get in touch</p>
      <h1 class="mt-4 mb-0 rv rv-wipe" style="--d:80ms;font-size:clamp(2.5rem,7vw,3.375rem);letter-spacing:-.03em">
        Let's <em style="font-style:italic;color:var(--accent)">connect</em>
      </h1>
      <p class="text-lg mt-6 mb-0 rv rv-up" style="--d:160ms;color:var(--muted);max-width:56ch">
        I'm looking for full-time work in data science, machine learning and analytics.
        Send a message below, or reach me directly on any of these.
      </p>
    </div>

    <div class="grid gap-10 lg:gap-14 mt-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.85fr)] items-start">
      <!-- ============ FORM ============ -->
      <div class="rv rv-rise min-w-0">
        <form
          id="contact-form"
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          novalidate
          class="panel p-6 sm:p-8"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>Leave this field empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="flex flex-col gap-5">
            <div>
              <label class="field-label" for="name">Name</label>
              <input class="field" id="name" name="name" type="text" required autocomplete="name" placeholder="Your name" />
              <p class="field-error hidden" data-error-for="name"></p>
            </div>

            <div>
              <label class="field-label" for="email">Email</label>
              <input class="field" id="email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
              <p class="field-error hidden" data-error-for="email"></p>
            </div>

            <div>
              <label class="field-label" for="message">Message</label>
              <textarea class="field" id="message" name="message" rows="5" required placeholder="What would you like to talk about?" style="min-height:130px;resize:vertical"></textarea>
              <p class="field-error hidden" data-error-for="message"></p>
            </div>

            <div class="flex flex-wrap items-center gap-4 pt-1">
              <button class="btn btn-primary" type="submit" id="submit-btn">
                <span id="submit-label">Send message</span>
                <svg id="submit-spinner" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" opacity="0.28" />
                  <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="0.8s" repeatCount="indefinite" />
                  </path>
                </svg>
              </button>
              <p class="font-mono text-xs m-0" style="color:var(--faint)">Usually replies within a day.</p>
            </div>
          </div>

          <!-- form-level states -->
          <div
            id="form-success"
            class="hidden mt-6 p-4 rounded-m"
            style="background:color-mix(in srgb, var(--ok) 10%, transparent);border:1px solid color-mix(in srgb, var(--ok) 40%, transparent)"
            role="status"
          >
            <p class="m-0 font-medium text-sm" style="color:var(--ok-text)">
              Message sent. I'll get back to you at the address you gave.
            </p>
          </div>

          <div
            id="form-error"
            class="hidden mt-6 p-4 rounded-m"
            style="background:color-mix(in srgb, var(--crit) 10%, transparent);border:1px solid color-mix(in srgb, var(--crit) 40%, transparent)"
            role="alert"
          >
            <p class="m-0 font-medium text-sm" style="color:var(--crit)">
              The message didn't send. Please try again, or email me directly at
              <a href="mailto:muhammadrizkysandyra26@gmail.com" style="color:inherit">muhammadrizkysandyra26@gmail.com</a>.
            </p>
          </div>
        </form>
      </div>

      <!-- ============ CHANNELS ============ -->
      <div class="rv rv-up min-w-0" style="--d:120ms">
        <div style="border-top:1px solid var(--line)">
          {channels.map((c) => (
            <a
              href={c.href}
              target={c.href.startsWith('mailto') ? '_self' : '_blank'}
              rel="noopener noreferrer"
              class="group flex items-start justify-between gap-5 py-5 no-underline"
              style="border-bottom:1px solid var(--line)"
            >
              <div class="min-w-0">
                <p class="font-mono text-xs font-medium uppercase m-0" style="color:var(--accent);letter-spacing:.12em">{c.label}</p>
                <p class="font-medium mt-1.5 mb-0 truncate" style="color:var(--ink)">{c.value}</p>
                <p class="text-sm mt-1 mb-0" style="color:var(--muted)">{c.note}</p>
              </div>
              <svg
                class="w-4 h-4 flex-none mt-1"
                style="color:var(--faint);transition:transform var(--dur-ui) var(--ease),color var(--dur-ui) var(--ease)"
                fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H9M17 7v8" />
              </svg>
            </a>
          ))}
        </div>

        <div
          class="mt-8 p-5 rounded-l flex items-start gap-3.5"
          style="background:color-mix(in srgb, var(--ok) 8%, transparent);border:1px solid color-mix(in srgb, var(--ok) 35%, transparent)"
        >
          <span aria-hidden="true" class="flex-none" style="width:8px;height:8px;border-radius:99px;background:var(--ok);margin-top:7px"></span>
          <div>
            <p class="font-medium m-0 text-sm" style="color:var(--ok-text)">Open to work</p>
            <p class="text-sm mt-1 mb-0" style="color:var(--muted)">
              Full-time roles, freelance projects and research collaboration. Remote, or based in Indonesia.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .group:hover svg {
    transform: translate(3px, -3px);
    color: var(--accent);
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const label = document.getElementById('submit-label');
  const spinner = document.getElementById('submit-spinner');
  const okBox = document.getElementById('form-success');
  const errBox = document.getElementById('form-error');

  const RULES: Record<string, (v: string) => string | null> = {
    name: (v) => (v.trim().length < 2 ? 'Please enter your name.' : null),
    email: (v) =>
      !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim())
        ? 'Please enter a valid email address.'
        : null,
    message: (v) =>
      v.trim().length < 10 ? 'Please write at least 10 characters.' : null,
  };

  function showError(field: HTMLInputElement | HTMLTextAreaElement, msg: string | null) {
    const box = document.querySelector<HTMLElement>(`[data-error-for="${field.name}"]`);
    if (!box) return;
    if (msg) {
      box.textContent = msg;
      box.classList.remove('hidden');
      field.setAttribute('aria-invalid', 'true');
      field.setAttribute('aria-describedby', `err-${field.name}`);
      box.id = `err-${field.name}`;
    } else {
      box.classList.add('hidden');
      field.removeAttribute('aria-invalid');
      field.removeAttribute('aria-describedby');
    }
  }

  function validate(field: HTMLInputElement | HTMLTextAreaElement): boolean {
    const rule = RULES[field.name];
    if (!rule) return true;
    const msg = rule(field.value);
    showError(field, msg);
    return !msg;
  }

  /* Validate on blur, then live-correct once a field has been touched. */
  Object.keys(RULES).forEach((n) => {
    const f = form?.elements.namedItem(n) as HTMLInputElement | null;
    if (!f) return;
    f.addEventListener('blur', () => validate(f));
    f.addEventListener('input', () => {
      if (f.getAttribute('aria-invalid') === 'true') validate(f);
    });
  });

  function setLoading(on: boolean) {
    if (!btn) return;
    btn.disabled = on;
    btn.style.opacity = on ? '0.75' : '';
    btn.style.cursor = on ? 'wait' : '';
    if (label) label.textContent = on ? 'Sending' : 'Send message';
    spinner?.classList.toggle('hidden', !on);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    okBox?.classList.add('hidden');
    errBox?.classList.add('hidden');

    const fields = Object.keys(RULES)
      .map((n) => form.elements.namedItem(n) as HTMLInputElement)
      .filter(Boolean);

    let firstBad: HTMLElement | null = null;
    fields.forEach((f) => {
      if (!validate(f) && !firstBad) firstBad = f;
    });
    if (firstBad) {
      (firstBad as HTMLElement).focus();
      return;
    }

    setLoading(true);
    try {
      const body = new URLSearchParams(new FormData(form) as any).toString();
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body,
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      okBox?.classList.remove('hidden');
      okBox?.scrollIntoView({ block: 'nearest' });
    } catch {
      errBox?.classList.remove('hidden');
      errBox?.scrollIntoView({ block: 'nearest' });
    } finally {
      setLoading(false);
    }
  });
</script>
