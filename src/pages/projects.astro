---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    title: 'Lung Disease Detection System (DenseNet-169)',
    description: 'Multimodal deep learning system to detect 11 lung conditions from chest X-rays. Achieved AUC 0.7586 (+111.5% above baseline). Implemented two-phase fine-tuning, CLAHE preprocessing, and Weighted Focal Loss for class imbalance up to 15:1.',
    tags: ['Python', 'DenseNet-169', 'TensorFlow', 'Keras', 'Medical Imaging', 'CLAHE'],
    github: 'https://github.com/MRSandyra/Lung-Diagnosis-Web',
    demo: '',
    featured: true,
  },
  {
    title: 'Anime Recommendation System',
    description: 'Hybrid recommendation system that considers user preferences and cultural context to provide more personalized anime suggestions.',
    tags: ['Python', 'Machine Learning', 'Recommendation System', 'Data Analysis'],
    github: 'https://github.com/MRSandyra/anime-recommender',
    demo: '',
    featured: false,
  },
  {
    title: 'Multi-Vector Cyber Attack Detection',
    description: 'Built an anomaly detection system using regex pattern matching and IP profiling. Detects 11 attack categories (SQLi, XSS, DoS, Brute Force, Path Traversal, etc.) from Apache/Nginx logs. Automated pipeline from parsing to report generation.',
    tags: ['Python', 'Regex', 'Pandas', 'Cybersecurity', 'Log Analysis', 'Anomaly Detection'],
    github: 'https://github.com/MRSandyra/portfolio/tree/main/Cybersecurity%20Anomali%20Detection',
    demo: '',
    featured: false,
  },
  {
    title: 'Sentiment Analysis on Tokopedia Reviews',
    description: 'Built an NLP pipeline for product review classification. Performed text preprocessing (tokenization, stopword removal, stemming) and trained multiple classifiers using Scikit-learn. Evaluated with accuracy and confusion matrix.',
    tags: ['Python', 'Scikit-learn', 'NLP', 'Pandas', 'NLTK', 'Sentiment Analysis'],
    github: 'https://github.com/MRSandyra/portfolio/tree/main/Sentiment%20Analysis%20Tokopedia',
    demo: '',
    featured: false,
  },
  {
    title: 'Global Income Inequality Analysis',
    description: 'Analyzed 2,400+ country income distributions using World Bank data. Calculated Gini Coefficient, built Lorenz Curves, and simulated redistribution policies (subsidies & progressive taxation). Created interactive visualizations (choropleth map, time series).',
    tags: ['Python', 'Pandas', 'Matplotlib', 'Plotly', 'Statistics', 'World Bank API'],
    github: 'https://github.com/MRSandyra/portfolio/tree/main/Global%20Income%20Inequality%20-%20Visualizing%20Lorenz%20Curves%20%26%20Gini%20Coefficients',
    demo: '',
    featured: false,
  },
  {
    title: 'IndoStock Analyzer',
    description: 'Automated stock analysis tool for IDX stocks combining news sentiment, fundamental analysis, and technical indicators to generate data-driven investment recommendations.',
    tags: ['Python', 'Selenium', 'TextBlob', 'yfinance', 'Pandas', 'NumPy'],
    github: 'https://github.com/MRSandyra/portfolio/tree/main/IndoStock%20Analyzer',
    demo: '',
    featured: false,
  },
];
---

<Layout title="Projects" description="Data science, ML, and analytics projects by Muhammad Rizky Sandvyra">
  <section class="pt-32 pb-20 px-6 max-w-6xl mx-auto">
    <div class="mb-16">
      <p class="section-label">Portfolio</p>
      <h1 class="font-display text-5xl md:text-6xl text-navy-900 dark:text-white mb-4">
        Selected <span class="italic text-indigo-600 dark:text-indigo-400">Projects</span>
      </h1>
      <p class="text-slate-500 dark:text-slate-400 max-w-xl leading-relaxed">
        A selection of my work — from deep learning for medical imaging to anomaly detection and data analytics.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project, i) => (
        <div class={`observe-fade opacity-0-init animate-delay-${Math.min(i * 100, 500)}`}>
          <ProjectCard {...project} />
        </div>
      ))}
    </div>

    <div class="mt-16 text-center observe-fade opacity-0-init">
      <p class="text-slate-500 dark:text-slate-400 mb-4 font-mono text-sm">More on GitHub →</p>
      <a href="https://github.com/MRSandyra/portfolio" target="_blank" rel="noopener" class="btn-primary">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
        </svg>
        View All on GitHub
      </a>
    </div>
  </section>
</Layout>