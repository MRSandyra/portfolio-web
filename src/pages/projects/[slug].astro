---
import Layout from '../../layouts/Layout.astro';
import ProjectVisual from '../../components/charts/ProjectVisual.astro';
import { projects } from '../../data/projects.js';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, index: i },
  }));
}

const { project, index } = Astro.props;
const { title, summary, kpis, stack, github, demo, demoNote, categories, study, evidence } = project;

const prev = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];
const recordId = String(index + 1).padStart(2, '0');
/* A project whose card visual is a chart still has an architecture worth showing. */
const hasSeparateArchitecture = Boolean(evidence?.stages) && evidence.type !== 'pipeline';

const sections = [
  { key: 'problem', label: 'Problem', body: study.problem },
  { key: 'data', label: 'Data', body: study.data },
  { key: 'approach', label: 'Approach', body: study.approach },
  { key: 'result', label: 'Result', body: study.result },
  { key: 'impact', label: 'Impact', body: study.impact },
];

const evidenceNote: Record<string, string> = {
  measured: 'Drawn from figures this project actually reports.',
  method: 'A method diagram; it asserts no measured result.',
  structural: 'Structure only. No performance figures were recorded for this project.',
};
---

<Layout
  title={title}
  description={summary}
  ogImage={`/og/${project.slug}.png`}
  type="article"
>
  <article>
    <!-- ============ HEADER ============ -->
    <section class="shell band">
      <a href="/projects" class="btn btn-link -ml-0.5 mb-7">
        <svg class="w-3.5 h-3.5 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
        </svg>
        All projects
      </a>

      <div class="flex items-center gap-2.5 flex-wrap mb-4 rv rv-up">
        {categories.map((c: string) => <span class="chip-accent">{c}</span>)}
        <span class="font-mono" style="font-size:10px;letter-spacing:.1em;color:var(--faint)">
          REC / {recordId}
        </span>
      </div>

      <h1
        class="m-0 rv rv-wipe"
        style="--d:60ms;font-size:clamp(2.25rem,6.2vw,3.375rem);letter-spacing:-.03em;max-width:20ch"
      >{title}</h1>

      <p class="text-lg mt-6 mb-0 rv rv-up" style="--d:140ms;color:var(--muted);max-width:60ch">
        {summary}
      </p>

      <div class="kpis mt-9 rv rv-scale" style="--d:200ms;max-width:34rem">
        {kpis.map((k: any) => (
          <div class="kpi">
            <b class="kpi-v">{k.value}{k.delta && <span class="kpi-d">{k.delta}</span>}</b>
            <span class="kpi-l">{k.label}</span>
          </div>
        ))}
      </div>

      <div class="flex flex-wrap items-center gap-3.5 mt-9 rv rv-up" style="--d:260ms">
        {github && (
          <a href={github} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            View the code
          </a>
        )}
        {demo ? (
          <a href={demo} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Live demo</a>
        ) : (
          <span class="inline-flex items-center gap-2 font-mono text-xs" style="color:var(--faint);min-height:44px">
            <span aria-hidden="true" style="width:6px;height:6px;border-radius:99px;background:var(--warn);flex:none"></span>
            {demoNote}
          </span>
        )}
      </div>
    </section>

    <!-- ============ EVIDENCE ============ -->
    <section
      class="band-tight"
      style="background:var(--sunk);border-top:1px solid var(--line);border-bottom:1px solid var(--line)"
    >
      <div class="shell-narrow">
        <p class="eyebrow m-0 mb-6 rv rv-up">Evidence</p>
        <div class="rv rv-scale" style="--d:80ms">
          <ProjectVisual project={project} />
        </div>
        <p class="font-mono text-xs mt-5 mb-0" style="color:var(--faint);letter-spacing:.04em">
          {evidenceNote[evidence.status]}
        </p>

        {hasSeparateArchitecture && (
          <div class="mt-12 rv rv-up">
            <p class="eyebrow m-0 mb-6">Architecture</p>
            <ProjectVisual project={project} variant="architecture" />
          </div>
        )}
      </div>
    </section>

    <!-- ============ CASE STUDY ============ -->
    <section class="shell-narrow band">
      <div class="flex flex-col" style="gap:clamp(2.5rem,6vw,4rem)">
        {sections.map((s, i) => (
          <div class="grid gap-3 sm:gap-8 sm:grid-cols-[120px_1fr] rv rv-up" style={`--d:${i * 60}ms`}>
            <div>
              <p
                class="font-mono text-xs font-semibold uppercase m-0 sm:sticky sm:top-24"
                style="color:var(--accent);letter-spacing:.12em"
              >
                <span style="color:var(--faint)">{String(i + 1).padStart(2, '0')}</span>
                <span class="ml-2">{s.label}</span>
              </p>
            </div>
            <div class="min-w-0">
              {Array.isArray(s.body) ? (
                <ul class="list-none m-0 p-0 flex flex-col gap-4">
                  {s.body.map((b: string) => (
                    <li class="flex gap-3.5">
                      <span aria-hidden="true" class="flex-none" style="color:var(--accent);margin-top:.55em;width:14px;height:1px;background:currentColor"></span>
                      <span style="color:var(--muted)">{b}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="m-0" style="color:var(--muted)">{s.body}</p>
              )}
            </div>
          </div>
        ))}

        <!-- stack -->
        <div class="grid gap-3 sm:gap-8 sm:grid-cols-[120px_1fr] rv rv-up">
          <div>
            <p class="font-mono text-xs font-semibold uppercase m-0" style="color:var(--accent);letter-spacing:.12em">
              <span style="color:var(--faint)">06</span><span class="ml-2">Stack</span>
            </p>
          </div>
          <ul class="flex flex-wrap gap-2 list-none m-0 p-0">
            {stack.map((t: string) => <li class="chip">{t}</li>)}
          </ul>
        </div>
      </div>
    </section>

    {study.broke && (
      <section class="band-tight" style="border-top:1px solid var(--line);background:var(--sunk)">
        <div class="shell-narrow">
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2 mb-3 rv rv-up">
            <p class="eyebrow m-0">What broke</p>
            <span class="font-mono text-xs" style="color:var(--faint);letter-spacing:.06em">
              INCIDENT RECORD · {study.broke.length} ENTRIES
            </span>
          </div>
          <p class="text-sm m-0 mb-8 rv rv-up" style="--d:60ms;color:var(--muted);max-width:62ch">
            Every one of these shipped, ran, and looked correct before it was caught.
            They are logged here for the same reason the pipeline logs them.
          </p>

          <ol class="list-none m-0 p-0" style="border-top:1px solid var(--line-2)">
            {study.broke.map((b: string, i: number) => (
              <li
                class="grid gap-2 sm:gap-6 sm:grid-cols-[58px_1fr] py-5 rv rv-up"
                style={`--d:${Math.min(i * 55, 280)}ms;border-bottom:1px solid var(--line-2)`}
              >
                <span
                  class="font-mono text-xs font-semibold"
                  style="color:var(--accent);letter-spacing:.1em;font-variant-numeric:tabular-nums"
                >INC-{String(i + 1).padStart(2, '0')}</span>
                <span class="text-sm" style="color:var(--ink-2)">{b}</span>
              </li>
            ))}
          </ol>

          {study.limits && (
            <div class="mt-10 rv rv-up">
              <p class="font-mono text-xs font-semibold uppercase m-0 mb-4"
                 style="color:var(--accent);letter-spacing:.12em">Known data limits</p>
              <ul class="list-none m-0 p-0 flex flex-col gap-3">
                {study.limits.map((l: string) => (
                  <li class="flex gap-3.5 text-sm" style="color:var(--muted)">
                    <span aria-hidden="true" class="flex-none"
                          style="color:var(--accent);margin-top:.6em;width:12px;height:1px;background:currentColor"></span>
                    <span>{l}</span>
                  </li>
                ))}
              </ul>
              <p class="text-sm mt-5 mb-0" style="color:var(--muted);max-width:62ch">
                Correlations are always reported with their sample size and p-value, and are
                never presented as causation.
              </p>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- ============ PREV / NEXT ============ -->
    <nav class="shell" style="padding-bottom:clamp(4rem,9vw,7rem)" aria-label="More projects">
      <div class="grid gap-4 sm:grid-cols-2" style="border-top:1px solid var(--line);padding-top:2.5rem">
        <a
          href={`/projects/${prev.slug}`}
          class="panel p-6 no-underline group"
          style="transition:border-color var(--dur-ui) var(--ease),transform var(--dur-slow) var(--ease)"
        >
          <span class="font-mono text-xs uppercase" style="color:var(--faint);letter-spacing:.12em">Previous</span>
          <span class="block font-display text-xl mt-2" style="color:var(--ink)">{prev.shortTitle}</span>
        </a>
        <a
          href={`/projects/${next.slug}`}
          class="panel p-6 no-underline sm:text-right"
          style="transition:border-color var(--dur-ui) var(--ease),transform var(--dur-slow) var(--ease)"
        >
          <span class="font-mono text-xs uppercase" style="color:var(--faint);letter-spacing:.12em">Next</span>
          <span class="block font-display text-xl mt-2" style="color:var(--ink)">{next.shortTitle}</span>
        </a>
      </div>
    </nav>
  </article>
</Layout>

<style>
  nav a.panel:hover {
    border-color: var(--line-2);
    transform: translateY(-2px);
  }
</style>
