---
import Layout from '../layouts/Layout.astro';

const techStack = [
  { name: 'Python', icon: '🐍' },
  { name: 'SQL', icon: '🗄️' },
  { name: 'Pandas', icon: '🐼' },
  { name: 'NumPy', icon: '🔢' },
  { name: 'Scikit-learn', icon: '🤖' },
  { name: 'TensorFlow', icon: '🧠' },
  { name: 'Keras', icon: '🔧' },
  { name: 'DenseNet', icon: '🖼️' },
  { name: 'Laravel', icon: '⚡' },
  { name: 'PHP', icon: '🐘' },
  { name: 'Regex', icon: '📝' },
  { name: 'PostgreSQL', icon: '🐘' },
  { name: 'Git', icon: '📦' },
  { name: 'Docker', icon: '🐳' },
];

const stats = [
  { value: '4+', label: 'ML Projects' },
  { value: '2', label: 'Industry Internships' },
  { value: '2,400+', label: 'Data Points Analyzed' },
  { value: '11', label: 'Attack Classes Detected' },
];
---

<Layout title="Home" description="Muhammad Rizky Sandyra — Data Scientist, ML Engineer & Analyst">
  <!-- Hero -->
  <section class="pt-32 pb-20 px-6 max-w-6xl mx-auto">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      <!-- Text -->
      <div>
        <p class="section-label animate-fade-up">Available for opportunities</p>
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-navy-900 dark:text-white leading-tight mb-6 animate-fade-up animate-delay-100">
          Muhammad<br/>
          <span class="block text-indigo-600 dark:text-indigo-400 italic">Rizky Sandyra</span>
        </h1>
        <div class="flex items-center gap-3 mb-6 animate-fade-up animate-delay-200">
          <div class="h-px w-12 bg-indigo-500"></div>
          <p class="font-mono text-sm font-medium text-indigo-600 dark:text-indigo-400 tracking-wide">
            Data Scientist · ML Engineer · Data Analyst
          </p>
        </div>
        <p class="text-slate-600 dark:text-slate-300 text-lg leading-relaxed mb-8 max-w-lg animate-fade-up animate-delay-300">
          Fresh graduate in Informatics with hands-on experience building end-to-end machine learning systems — from deep learning for medical imaging to anomaly detection for cybersecurity.
        </p>
        <div class="flex flex-wrap gap-3 animate-fade-up animate-delay-400">
          <a href="/projects" class="btn-primary">View Projects</a>
          <a href="/resume" class="btn-outline">Download CV</a>
        </div>
      </div>

      <!-- Avatar / Visual -->
      <div class="flex justify-center animate-fade-up animate-delay-200">
        <div class="relative">
          <div class="absolute inset-0 rounded-full border-2 border-dashed border-indigo-200 dark:border-indigo-900 animate-[spin_20s_linear_infinite]"></div>
          <div class="absolute -inset-4 rounded-full border border-slate-200 dark:border-navy-700"></div>
          <div class="relative w-64 h-64 rounded-full bg-gradient-to-br from-navy-800 to-indigo-700 flex items-center justify-center shadow-2xl shadow-indigo-900/30">
            <span class="font-display text-7xl text-white/90 italic">MR</span>
            <div class="absolute bottom-4 right-4 flex items-center gap-2 bg-white dark:bg-navy-900 rounded-full px-3 py-1.5 shadow-lg border border-slate-100 dark:border-navy-700">
              <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
              <span class="text-xs font-mono font-medium text-slate-600 dark:text-slate-300">Open to work</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-slate-100 dark:border-navy-800 bg-slate-50 dark:bg-navy-900/50 py-12 px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8">
      {stats.map((stat, i) => (
        <div class={`text-center observe-fade opacity-0-init animate-delay-${i * 100}`}>
          <div class="font-display text-4xl text-navy-900 dark:text-white mb-1">{stat.value}</div>
          <div class="text-sm text-slate-500 dark:text-slate-400 font-mono">{stat.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Tech Stack -->
  <section class="py-20 px-6 max-w-6xl mx-auto">
    <div class="text-center mb-12 observe-fade opacity-0-init">
      <p class="section-label">Toolbox</p>
      <h2 class="font-display text-3xl md:text-4xl text-navy-900 dark:text-white">
        Technologies I Work With
      </h2>
    </div>

    <div class="flex flex-wrap justify-center gap-3 observe-fade opacity-0-init animate-delay-200">
      {techStack.map(tech => (
        <span class="badge text-sm py-2 px-4 cursor-default">
          <span>{tech.icon}</span>
          {tech.name}
        </span>
      ))}
    </div>
  </section>

  <!-- About teaser -->
  <section class="py-16 px-6 bg-navy-900 dark:bg-navy-950">
    <div class="max-w-4xl mx-auto text-center observe-fade opacity-0-init">
      <p class="section-label text-indigo-400">About</p>
      <blockquote class="font-display text-2xl md:text-3xl text-white leading-relaxed mb-8 italic">
        "I turn data into decisions — from medical images to security logs."
      </blockquote>
      <p class="text-slate-400 max-w-2xl mx-auto leading-relaxed mb-8">
        Based in Padang, West Sumatera, Indonesia. Passionate about roles that combine data and artificial intelligence to deliver real-world solutions. Experienced in deep learning (DenseNet-169), anomaly detection, and full-stack analytics.
      </p>
      <a href="/contact" class="btn-primary">Let's Connect</a>
    </div>
  </section>
</Layout>