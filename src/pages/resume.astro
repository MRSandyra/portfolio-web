---
import Layout from '../layouts/Layout.astro';

const experience = [
  {
    role: 'Intern — Electrostatic Precipitator & Dust Collecting Maintenance Unit',
    company: 'PT. Semen Padang',
    period: 'Nov 2025 – May 2026',
    location: 'Padang, Indonesia',
    bullets: [
      'Developed a web-based Maintenance Service Order (MSO) application using Laravel to digitize ESP and dust collector maintenance, improving tracking and work assignment efficiency.',
      'Implemented CRUD operations, multi-role authentication (operator, technician, supervisor), and a performance dashboard displaying MTTR, MTBF, and equipment status.',
      'Gained deep understanding of industrial maintenance workflows and system integration with field requirements.',
    ],
  },
  {
    role: 'Intern — Statistics & Cryptography Department',
    company: 'Dinas Komunikasi dan Informatika (DISKOMINFO) Padang City',
    period: 'Jul 2024 – Oct 2024',
    location: 'Padang, Indonesia',
    bullets: [
      'Built a multi-vector attack detection system using Python to analyze server logs and detect 11 attack categories (SQL Injection, XSS, DoS, Brute Force, Path Traversal, etc.).',
      'Implemented regex pattern matching with URL decoding pipeline to detect encoded attack payloads in Apache/Nginx log formats.',
      'Developed behavioral anomaly detection based on IP profiling for automatic identification of Brute Force (>5 attempts) and DoS attacks (>100 requests).',
      'Automated the entire pipeline from raw log parsing to report generation using Pandas, producing structured CSV output for security team forensic analysis.',
    ],
  },
];

const education = [
  {
    degree: 'Bachelor of Informatics (S1)',
    institution: 'Universitas Negeri Padang',
    period: '2021 – 2025',
    detail:
      'Focus: Data Analysis, Machine Learning, and Statistics. Final Project: Lung Disease Detection System based on Deep Learning (DenseNet-169) for medical image classification.',
  },
];

const certifications: { name: string; issuer: string; year: string }[] = [];

/* Three equal pillars. Data engineering is listed first and given the same
   weight as the other two - it is half the work and the site used to omit it. */
const pillars = [
  {
    name: 'Data Engineering',
    blurb: 'Governed ingestion, orchestration and warehouse modelling.',
    items: ['Apache Airflow', 'Apache Kafka', 'Redpanda', 'Apache Spark', 'dbt', 'PostgreSQL', 'MongoDB', 'ClickHouse', 'DuckDB', 'MinIO', 'Pydantic data contracts', 'Docker Compose'],
  },
  {
    name: 'Machine Learning & AI',
    blurb: 'Modelling, interpretation and the audits that keep results honest.',
    items: ['TensorFlow', 'Keras', 'Scikit-learn', 'XGBoost', 'SHAP', 'DenseNet-169', 'NLP (Indonesian)', 'Anomaly detection', 'Recommender systems'],
  },
  {
    name: 'Analytics & Visualization',
    blurb: 'Turning modelled data into something a person can act on.',
    items: ['Tableau', 'Superset', 'Metabase', 'Streamlit', 'Plotly', 'Seaborn', 'Pandas', 'NumPy', 'SQL', 'Statistics'],
  },
];

const activities = [
  'Summer Course at INTI International University, Malaysia — selected for an academic and cultural exchange programme.',
  'MSIB Independent Study at MIKTI — Data Science — practical work in data analysis and machine learning.',
  'CEO of INFINITE TECHNOLOGY UNP (2023) — led initiatives to drive innovation and digital literacy on campus.',
];
---

<Layout
  title="Resume"
  description="Resume of Muhammad Rizky Sandyra — Informatics graduate, internships at PT. Semen Padang and DISKOMINFO Padang City. Skills across data engineering, machine learning and analytics."
  ogImage="/og/resume.png"
>
  <section class="shell-narrow band-lg">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
      <div class="rv rv-up">
        <p class="eyebrow m-0">Curriculum vitae</p>
        <h1 class="mt-4 mb-0" style="font-size:clamp(2.25rem,6.2vw,3.375rem);letter-spacing:-.03em">
          Muhammad <em style="font-style:italic;color:var(--accent)">Rizky Sandyra</em>
        </h1>
      </div>
      <a href="/resume.pdf" download class="btn btn-primary self-start md:self-auto rv rv-up" style="--d:80ms">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-5-5m5 5l5-5M4 20h16" />
        </svg>
        Download PDF
      </a>
    </div>

    <div class="flex flex-col" style="gap:clamp(3rem,7vw,4.5rem)">
      <!-- EXPERIENCE -->
      <section class="rv rv-up">
        <div class="flex items-center gap-4 mb-8">
          <p class="eyebrow eyebrow-plain m-0">Experience</p>
          <span class="flex-1 h-px" style="background:var(--line)"></span>
        </div>
        <div class="flex flex-col gap-10">
          {experience.map((exp) => (
            <div class="grid gap-3 md:gap-8 md:grid-cols-[190px_1fr]">
              <div class="md:text-right">
                <p class="font-mono text-xs m-0" style="color:var(--accent);letter-spacing:.04em">{exp.period}</p>
                <p class="text-xs mt-1 m-0" style="color:var(--faint)">{exp.location}</p>
              </div>
              <div class="min-w-0">
                <h3 class="text-xl m-0">{exp.role}</h3>
                <p class="font-mono text-sm font-medium mt-1.5 mb-4" style="color:var(--accent)">{exp.company}</p>
                <ul class="list-none m-0 p-0 flex flex-col gap-2.5">
                  {exp.bullets.map((b) => (
                    <li class="flex gap-3.5 text-sm" style="color:var(--muted)">
                      <span aria-hidden="true" class="flex-none" style="color:var(--accent);margin-top:.6em;width:12px;height:1px;background:currentColor"></span>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- SKILLS -->
      <section class="rv rv-up">
        <div class="flex items-center gap-4 mb-8">
          <p class="eyebrow eyebrow-plain m-0">Skills</p>
          <span class="flex-1 h-px" style="background:var(--line)"></span>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {pillars.map((pil, i) => (
            <div class="panel p-5 min-w-0">
              <p class="font-mono text-xs font-semibold uppercase m-0"
                 style="color:var(--accent);letter-spacing:.12em">
                <span style="color:var(--faint)">{String(i + 1).padStart(2, '0')}</span>
                <span class="ml-2">{pil.name}</span>
              </p>
              <p class="text-sm mt-2.5 mb-4" style="color:var(--muted)">{pil.blurb}</p>
              <ul class="flex flex-wrap gap-1.5 list-none m-0 p-0">
                {pil.items.map((it) => <li class="chip">{it}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- EDUCATION -->
      <section class="rv rv-up">
        <div class="flex items-center gap-4 mb-8">
          <p class="eyebrow eyebrow-plain m-0">Education</p>
          <span class="flex-1 h-px" style="background:var(--line)"></span>
        </div>
        <div class="flex flex-col gap-8">
          {education.map((edu) => (
            <div class="grid gap-3 md:gap-8 md:grid-cols-[190px_1fr]">
              <div class="md:text-right">
                <p class="font-mono text-xs m-0" style="color:var(--accent);letter-spacing:.04em">{edu.period}</p>
              </div>
              <div class="min-w-0">
                <h3 class="text-xl m-0">{edu.degree}</h3>
                <p class="font-mono text-sm font-medium mt-1.5 mb-2.5" style="color:var(--accent)">{edu.institution}</p>
                <p class="text-sm m-0" style="color:var(--muted)">{edu.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ACTIVITIES -->
      <section class="rv rv-up">
        <div class="flex items-center gap-4 mb-8">
          <p class="eyebrow eyebrow-plain m-0">Activities &amp; leadership</p>
          <span class="flex-1 h-px" style="background:var(--line)"></span>
        </div>
        <ul class="list-none m-0 p-0 flex flex-col gap-3">
          {activities.map((a) => (
            <li class="flex gap-3.5 text-sm" style="color:var(--muted)">
              <span aria-hidden="true" class="flex-none" style="color:var(--accent);margin-top:.6em;width:12px;height:1px;background:currentColor"></span>
              <span>{a}</span>
            </li>
          ))}
        </ul>
      </section>

      {certifications.length > 0 && (
        <section class="rv rv-up">
          <div class="flex items-center gap-4 mb-8">
            <p class="eyebrow eyebrow-plain m-0">Certifications</p>
            <span class="flex-1 h-px" style="background:var(--line)"></span>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {certifications.map((cert) => (
              <div class="panel p-4">
                <p class="text-sm font-medium m-0" style="color:var(--ink)">{cert.name}</p>
                <p class="font-mono text-xs mt-1 m-0" style="color:var(--muted)">{cert.issuer} · {cert.year}</p>
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>
</Layout>
